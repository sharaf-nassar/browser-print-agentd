<?xml version="1.0" encoding="utf-8"?>
<!--
  productbuild distribution definition for the GUI uninstaller.

  Rendered by build-pkg.sh from packaging/identity.sh. This package carries no
  payload at all: its component is built with pkgbuild's nopayload flag, and its
  postinstall script's only job is to exec the uninstaller the product package
  already installed. That is why it needs no hostArchitectures value — there is
  no binary here to be wrong about.

  Note for editors: a double hyphen is illegal inside an XML comment, so flag
  names are written here without their leading dashes on purpose.

  installation-check runs BEFORE anything else and refuses the package outright
  when the product is not installed, so a second double-click reports "not
  installed" in a real dialog instead of running a script that finds nothing.
  Apple's schema requires that a failing check set both my.result.type and
  my.result.message; those are the only two documented fields, so those are the
  only two set.

  The Installer's primary button is not customizable — it says Install no matter
  what this package does. The title, the welcome pane and the conclusion pane
  are the three places the schema does let us say "remove", so all three do.
-->
<installer-gui-script minSpecVersion="2">
    <title>__UNINSTALL_TITLE__</title>
    <options customize="never" allow-external-scripts="false"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

    <welcome file="welcome.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.txt" mime-type="text/plain"/>

    <script><![CDATA[
        function productIsInstalled() {
            if (system.files.fileExistsAtPath('__UNINSTALLER_PATH__')) {
                return true;
            }
            my.result.type = 'Fatal';
            my.result.message = '__PRODUCT_TITLE__ is not installed on this Mac, '
                + 'so there is nothing to remove.';
            return false;
        }
    ]]></script>
    <installation-check script="productIsInstalled()"/>

    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="default">
            <line choice="__UNINSTALL_PKG_ID__"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="__UNINSTALL_PKG_ID__" visible="false">
        <pkg-ref id="__UNINSTALL_PKG_ID__"/>
    </choice>
    <pkg-ref id="__UNINSTALL_PKG_ID__" onConclusion="none">__UNINSTALL_COMPONENT_PKG_NAME__</pkg-ref>
</installer-gui-script>
